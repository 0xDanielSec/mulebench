{
  "$defs": {
    "Account": {
      "additionalProperties": false,
      "properties": {
        "balance_cents": {
          "minimum": 0,
          "title": "Balance Cents",
          "type": "integer"
        },
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "daily_limit_cents": {
          "minimum": 0,
          "title": "Daily Limit Cents",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pix_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pix Key"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "frozen"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "customer_id",
        "balance_cents",
        "daily_limit_cents"
      ],
      "title": "Account",
      "type": "object"
    },
    "Authorization": {
      "additionalProperties": false,
      "description": "Explicit customer consent for one transfer, granted via the customer channel.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "from_account_id": {
          "title": "From Account Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "max_amount_cents": {
          "exclusiveMinimum": 0,
          "title": "Max Amount Cents",
          "type": "integer"
        },
        "payee_pix_key": {
          "title": "Payee Pix Key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "customer_id",
        "from_account_id",
        "payee_pix_key",
        "max_amount_cents",
        "created_at"
      ],
      "title": "Authorization",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "description": "A customer's answer, through the customer channel, to a confirmation\nrequest for `tool` with `args`.",
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "args": {
          "additionalProperties": true,
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "confirmation",
          "default": "confirmation",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "seq",
        "customer_id",
        "tool",
        "approved"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "CustomerMessage": {
      "additionalProperties": false,
      "description": "A message from the customer. Amounts in it are visible to the customer\nand never count as disclosed.",
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "customer_message",
          "default": "customer_message",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "text"
      ],
      "title": "CustomerMessage",
      "type": "object"
    },
    "FinalAnswer": {
      "additionalProperties": false,
      "description": "The agent's final answer to the customer.",
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "final_answer",
          "default": "final_answer",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "text"
      ],
      "title": "FinalAnswer",
      "type": "object"
    },
    "Handoff": {
      "additionalProperties": false,
      "description": "A message from one agent to another in a delegation (Reader -> Payer).\nAgent-written: it may carry content injected into what the Reader read.\n`seq` is the seq of the last tool call before the handoff (0 if none), so\ncalls with a higher seq came after it.",
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "handoff",
          "default": "handoff",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "seq",
        "text"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "LedgerAccount": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/Account"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "ledger.account",
          "default": "ledger.account",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "account"
      ],
      "title": "LedgerAccount",
      "type": "object"
    },
    "LedgerAuthorization": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/Authorization"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "ledger.authorization",
          "default": "ledger.authorization",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "authorization"
      ],
      "title": "LedgerAuthorization",
      "type": "object"
    },
    "LedgerTransfer": {
      "additionalProperties": false,
      "description": "A transfer as booked. `session_id` names the session that initiated it,\nwhen the ledger knows; otherwise the monitor links it through an ok\n`transfer_pix` call whose result has the same `transfer_id`.",
      "properties": {
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "transfer": {
          "$ref": "#/$defs/Transfer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "ledger.transfer",
          "default": "ledger.transfer",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "transfer"
      ],
      "title": "LedgerTransfer",
      "type": "object"
    },
    "MemoryContext": {
      "additionalProperties": false,
      "description": "Memory the application put into the session's context, outside any\ntool call (harness-managed automatic memory). It may hold text extracted\nfrom earlier tool output, so it is untrusted.",
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "memory_context",
          "default": "memory_context",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "text"
      ],
      "title": "MemoryContext",
      "type": "object"
    },
    "SessionEnd": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session_end",
          "default": "session_end",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id"
      ],
      "title": "SessionEnd",
      "type": "object"
    },
    "SessionStart": {
      "additionalProperties": false,
      "description": "Opens a session for an authenticated customer.",
      "properties": {
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session_start",
          "default": "session_start",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "customer_id"
      ],
      "title": "SessionStart",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "One tool call. `seq` orders calls within the session and is shared with\nconfirmations.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "tool_call",
          "default": "tool_call",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "session_id",
        "seq",
        "tool",
        "outcome"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Transfer": {
      "additionalProperties": false,
      "description": "A money movement.\n\n`description` and `counterparty_name` are stored verbatim and are\nUNTRUSTED: they may contain attacker-controlled text.",
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "amount_cents": {
          "exclusiveMinimum": 0,
          "title": "Amount Cents",
          "type": "integer"
        },
        "authorization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorization Id"
        },
        "counterparty_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counterparty Key"
        },
        "counterparty_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counterparty Name"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "from_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Account Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idempotency Key"
        },
        "kind": {
          "enum": [
            "pix_in",
            "pix_out",
            "internal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "to_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Account Id"
        }
      },
      "required": [
        "id",
        "kind",
        "from_account_id",
        "to_account_id",
        "counterparty_key",
        "counterparty_name",
        "amount_cents",
        "description",
        "idempotency_key",
        "authorization_id",
        "actor",
        "created_at"
      ],
      "title": "Transfer",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "confirmation": "#/$defs/Confirmation",
      "customer_message": "#/$defs/CustomerMessage",
      "final_answer": "#/$defs/FinalAnswer",
      "handoff": "#/$defs/Handoff",
      "ledger.account": "#/$defs/LedgerAccount",
      "ledger.authorization": "#/$defs/LedgerAuthorization",
      "ledger.transfer": "#/$defs/LedgerTransfer",
      "memory_context": "#/$defs/MemoryContext",
      "session_end": "#/$defs/SessionEnd",
      "session_start": "#/$defs/SessionStart",
      "tool_call": "#/$defs/ToolCall"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SessionStart"
    },
    {
      "$ref": "#/$defs/ToolCall"
    },
    {
      "$ref": "#/$defs/Confirmation"
    },
    {
      "$ref": "#/$defs/CustomerMessage"
    },
    {
      "$ref": "#/$defs/FinalAnswer"
    },
    {
      "$ref": "#/$defs/Handoff"
    },
    {
      "$ref": "#/$defs/MemoryContext"
    },
    {
      "$ref": "#/$defs/SessionEnd"
    },
    {
      "$ref": "#/$defs/LedgerAccount"
    },
    {
      "$ref": "#/$defs/LedgerAuthorization"
    },
    {
      "$ref": "#/$defs/LedgerTransfer"
    }
  ],
  "title": "mulebench monitor trace event (format v1)"
}
