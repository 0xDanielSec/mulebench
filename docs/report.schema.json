          "type": "integer"
        },
        "ok_calls": {
          "title": "Ok Calls",
          "type": "integer"
        },
        "denied_calls": {
          "title": "Denied Calls",
          "type": "integer"
        },
        "failed_calls": {
          "title": "Failed Calls",
          "type": "integer"
        },
        "injected_steps": {
          "title": "Injected Steps",
          "type": "integer"
        }
