      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
