          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "payload_exposed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payload Exposed"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "exposed_resisted",
                "exposed_violated",
                "not_exposed"
